generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- auth ----------------------------------------------------------------------

// Identity/credential. The rich domain `User` maps email/password to value
// objects; `name` is display-only and never authenticates (login is by e-mail).
model User {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String
  name        String?
  active      Boolean   @default(true)
  // 'user' | 'admin'. Not an enum on purpose: the ONLY way to promote someone
  // is an UPDATE run by hand against this column, and a plain string keeps that
  // possible without a migration. The domain reads it fail-closed — anything
  // that is not exactly 'admin' is an ordinary user.
  role        String    @default("user")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastLoginAt DateTime? @map("last_login_at")

  @@map("users")
}

// Stateful refresh session: one row per login/device. Stores only the HASH of
// the refresh token; rotation + reuse detection sustain logout. userId is a
// LOGICAL FK to User (no relation, to avoid coupling contexts).
model AuthSession {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  verifierHash String   @map("verifier_hash")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("auth_sessions")
}

// --- recording -----------------------------------------------------------------

// The audio itself: what the user recorded in the browser or uploaded, plus the
// pipeline status (pending -> transcribing -> summarizing -> ready | failed).
// The FILE lives on disk (see the Uploads section of CLAUDE.md); only its path
// is stored here. `ownerId` is a LOGICAL FK to User.
model Recording {
  id              String   @id @default(uuid())
  ownerId         String   @map("owner_id")
  title           String
  // What kind of audio it is ('meeting' | 'class' | 'medical' | 'interview' |
  // 'note' | 'other'), which picks the summary TEMPLATE in the worker. A plain
  // string and not an enum, for the same reason `role` is: the domain reads it
  // fail-closed, so anything unknown is the generic template and no migration is
  // needed to try another kind out.
  kind            String   @default("other")
  source          String
  audioUrl        String   @map("audio_url")
  mimeType        String   @map("mime_type")
  sizeBytes       Int      @map("size_bytes")
  durationSeconds Int      @map("duration_seconds")
  status          String   @default("pending")
  failureReason   String?  @map("failure_reason")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([ownerId, createdAt])
  @@map("recordings")
}

// --- transcription -------------------------------------------------------------

// What the speech-to-text model heard. One per recording (`recordingId` is
// unique), which is what makes re-processing idempotent: the pipeline upserts
// instead of piling up transcripts. LOGICAL FK — transcription and recording
// are different contexts.
model Transcription {
  id          String   @id @default(uuid())
  recordingId String   @unique @map("recording_id")
  text        String
  language    String?
  model       String
  // When each stretch of speech was said, as the model reported it — the list
  // the detail screen turns into clickable timestamps. Json and not a table:
  // it is always read and written WITH the transcript and never queried on its
  // own, exactly like the summary's topics/action_items.
  segments    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("transcriptions")
}

// --- summary -------------------------------------------------------------------

// What the LLM wrote about the transcript, plus the rendered PDF. `topics` and
// `actionItems` are scalar lists: they are the summary's own bullets, always
// read and written with it, and never queried on their own. `pdfUrl` is null
// until the PDF is rendered (a second step of the same pipeline).
model Summary {
  id          String   @id @default(uuid())
  recordingId String   @unique @map("recording_id")
  headline    String
  overview    String
  topics      String[]
  actionItems String[] @map("action_items")
  model       String
  pdfUrl      String?  @map("pdf_url")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("summaries")
}

// --- notification --------------------------------------------------------------

// One line in a user's inbox. The unique triple is what makes delivery
// IDEMPOTENT: a retried pipeline job re-sending the same event is a no-op
// instead of a duplicated line (see NotificationRepository.createMany).
// `user_id` is a LOGICAL FK.
model Notification {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  type        String
  title       String
  body        String
  link        String?
  referenceId String?   @map("reference_id")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([userId, type, referenceId])
  @@index([userId, createdAt])
  @@map("notifications")
}

// --- task ----------------------------------------------------------------------

// One thing the audio said somebody has to do — an action item promoted out of a
// summary and given a life of its own.
//
// MATERIALIZED and not derived from the summary at read time: a task read out of
// the summary would have nowhere to remember it was ticked, and processing the
// recording again would silently un-tick everything. The unique pair
// (recording_id, text) is what makes a re-run idempotent, exactly like the
// inbox's triple. `owner_id` is a LOGICAL FK — it lives here so "everything I
// still have to do" is ONE query instead of a join through the recordings.
model Task {
  id          String    @id @default(uuid())
  ownerId     String    @map("owner_id")
  recordingId String    @map("recording_id")
  text        String
  doneAt      DateTime? @map("done_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([recordingId, text])
  @@index([ownerId, doneAt])
  @@map("tasks")
}

// --- sharing -------------------------------------------------------------------

// A link that lets somebody WITHOUT an account read one recording's summary.
//
// `token` is the secret in the URL and the only authorization the public page
// has — unique, and the column the public read looks up by. `expires_at` is NOT
// nullable on purpose: there is no eternal link, so forgetting about one means
// it stops working instead of staying open forever. A revoked link keeps its
// row (the owner has to be able to see that it existed and was cut off); only
// deleting the RECORDING deletes its links.
model ShareLink {
  id                 String    @id @default(uuid())
  ownerId            String    @map("owner_id")
  recordingId        String    @map("recording_id")
  token              String    @unique
  includesTranscript Boolean   @default(false) @map("includes_transcript")
  includesAudio      Boolean   @default(false) @map("includes_audio")
  expiresAt          DateTime  @map("expires_at")
  revokedAt          DateTime? @map("revoked_at")
  viewCount          Int       @default(0) @map("view_count")
  lastViewedAt       DateTime? @map("last_viewed_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([ownerId, createdAt])
  @@index([recordingId])
  @@map("share_links")
}

// --- annotation ----------------------------------------------------------------

// A point in a recording somebody wanted to come back to, with or without
// something written about it — a "marcador" and an "anotação" are the same row,
// the difference is whether `note` is filled in.
//
// The anchor is the TIME and not a transcript segment, which is what makes a
// mark survive re-processing: the audio does not change, so second 412 is still
// second 412 even when a better model redraws the segments around it. Both FKs
// are LOGICAL. No unique index on (recording, second): two marks on the same
// second are two thoughts, not a mistake.
model Annotation {
  id          String   @id @default(uuid())
  ownerId     String   @map("owner_id")
  recordingId String   @map("recording_id")
  atSeconds   Int      @map("at_seconds")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([recordingId, atSeconds])
  @@index([ownerId, createdAt])
  @@map("annotations")
}
