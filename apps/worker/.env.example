# --- IA (Groq) ---------------------------------------------------------------
# Sem GROQ_API_KEY o worker SE RECUSA a iniciar (fail-closed). Nao deixe vazia.
# A MESMA chave serve pros dois passos: transcrever e resumir.
GROQ_API_KEY=""
# Modelo de chat que escreve o resumo. E uma PREFERENCIA, nao uma trava: se a
# chave nao tiver acesso a esse modelo (a Groq aposenta modelo e libera modelo
# por conta), o worker cai automaticamente pro proximo da lista de fallback em
# apps/worker/src/extraction/groq-llm.ts e segue resumindo.
GROQ_MODEL="openai/gpt-oss-120b"
# Modelo de fala->texto que gera a transcricao.
GROQ_TRANSCRIPTION_MODEL="whisper-large-v3"
# Quanto da transcricao vai pro modelo de chat.
#
# ATENCAO ao teto da SUA conta na Groq: a resposta do erro traz
# `x-ratelimit-limit-tokens`, que e o orcamento de tokens por MINUTO, e essa
# janela tem que caber a transcricao MAIS a resposta. No tier gratuito ele e
# 8000/min: 24000 caracteres de portugues sao ~7000 tokens, entao com a resposta
# junto nao cabe e a chamada passa a bater no 429 (que tem retry com backoff,
# mas cada tentativa gasta a janela). Se a conta for gratuita, 12000 aqui e o
# valor que fecha a conta.
TRANSCRIPT_CHAR_LIMIT="24000"
# Teto da RESPOSTA, em tokens. Explicito de proposito: com response_format
# json_object, uma resposta que estoura o orcamento no meio do documento volta
# como 400 json_validate_failed ("max completion tokens reached before
# generating a valid document") — nao e falha retentavel nem problema de modelo,
# e derrubava a gravacao inteira. Se estourar assim mesmo, o worker pede um
# resumo mais curto uma vez antes de desistir.
GROQ_MAX_COMPLETION_TOKENS="2500"
# Idioma em que o RESUMO e escrito (o do audio o modelo detecta sozinho).
SUMMARY_LANGUAGE="pt"

# --- Runtime (BullMQ + banco) ------------------------------------------------
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/audiomind?schema=public"
# Precisa apontar pro MESMO Redis do backend (fila + push do sininho).
REDIS_URL="redis://localhost:6379"
# Quantos audios o worker processa em paralelo.
WORKER_CONCURRENCY="2"
# A MESMA pasta de uploads que o backend enxerga (volume compartilhado): o
# worker le o audio dali e escreve os PDFs. O default assume dev no host.
# UPLOADS_DIR="/repo/apps/backend/uploads"
