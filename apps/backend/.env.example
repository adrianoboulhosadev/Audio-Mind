DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/audiomind?schema=public"
JWT_SECRET="change-this-secret-in-production"
PORT=5000
# Front (Next) origin. CORS with credentials requires a specific origin.
WEB_ORIGIN="http://localhost:3000"
# Pipeline queue (BullMQ producer). Must point to the same Redis as the worker.
REDIS_URL="redis://localhost:6379"
# Where uploaded audio and generated PDFs live. The worker MUST see the same
# folder (a shared volume in docker-compose) — it reads the audio and writes
# the PDFs there. Defaults to <cwd>/uploads, i.e. apps/backend/uploads in dev.
# UPLOADS_DIR="/repo/apps/backend/uploads"

# --- IA (Groq) ---------------------------------------------------------------
# So pra rota "perguntar sobre esse audio" (POST /summary/recording/:id/ask).
# E a MESMA chave do worker. Sem ela o backend SOBE normalmente e so essa rota
# falha — diferente do worker, que sem IA nao teria o que fazer e recusa iniciar.
GROQ_API_KEY=""
# Modelo de chat. Preferencia, nao trava: sem acesso a ele o backend cai pro
# proximo da lista (mesma logica do worker).
GROQ_MODEL="openai/gpt-oss-120b"
# Quanto da transcricao vai no prompt da pergunta.
TRANSCRIPT_CHAR_LIMIT="24000"
