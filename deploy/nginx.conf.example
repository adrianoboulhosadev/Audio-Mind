# EXEMPLO de reverse proxy pra VPS (Nginx nativo no host, fora do Docker).
# Front e API no MESMO domínio, com /api/* indo pro backend.
#
# É um EXEMPLO, e por isso termina em `.example`: o arquivo que vale é o de
# `/etc/nginx/`, e ele carrega coisas que são do servidor e não do projeto —
# domínio, certificado, portas. Copie e edite lá:
#
#     sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/audio-mind
#     sudo ln -s /etc/nginx/sites-available/audio-mind /etc/nginx/sites-enabled/
#     sudo nginx -t && sudo systemctl reload nginx
#
# ⚠️ AS PORTAS AQUI TÊM QUE BATER com as que o compose publica no host, que vêm
# do `.env` da raiz (BACKEND_PORT e WEB_PORT — veja o .env.example). Os defaults
# abaixo são os do compose. Se elas divergirem, o Nginx responde 502 e parece
# que o app caiu.
#
# Três coisas aqui NÃO são opcionais — cada uma é uma falha real que o tráfego
# deste app encontra.

server {
    listen 80;
    server_name _;

    # The default is 1 MB and an audio goes up to 25 MB. Without this, every
    # upload bigger than a voice memo takes a 413 AT THE PROXY and never reaches
    # the backend — which then looks like a bug in the app.
    client_max_body_size 30m;

    # An upload of 25 MB over a phone connection takes a while; the default
    # 60s read timeout would cut it off mid-transfer.
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    # SSE needs its own block: with buffering on (the default) Nginx holds the
    # events until its buffer fills, so the page looks frozen — exactly the wait
    # the live push exists to remove. HTTP/1.1 + an empty Connection header is
    # what keeps the connection open at all.
    location = /api/notification/stream {
        proxy_pass http://127.0.0.1:5001/notification/stream;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_cache off;
        # A stream is supposed to sit idle between events; a normal read timeout
        # would kill it every minute and make EventSource reconnect forever.
        proxy_read_timeout 24h;
    }

    # The audio stream also needs buffering off: with it on, Nginx tries to read
    # the whole upstream response before answering, which throws away the point
    # of a Range request — the browser asked for 300 KB around a timestamp, not
    # for the file. `proxy_force_ranges` keeps ranges working even when the
    # upstream answer arrives without an Accept-Ranges Nginx trusts.
    location /api/recording/stream/ {
        proxy_pass http://127.0.0.1:5001/recording/stream/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_buffering off;
        proxy_force_ranges on;
    }

    # A shared link may carry the audio, and that route streams by Range too —
    # same reasoning as the block above, different authorization (the token in
    # the path instead of a capability in the query string).
    location /api/share/public/ {
        proxy_pass http://127.0.0.1:5001/share/public/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_buffering off;
        proxy_force_ranges on;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:5001/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:3003;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ⚠️ Enquanto for `listen 80` sem TLS, O LOGIN NÃO PERSISTE: o cookie de refresh
# é `secure` (NODE_ENV=production no Dockerfile), e o navegador não guarda cookie
# `secure` em HTTP puro. Rode o certbot antes de usar isso pra valer — ele
# reescreve este bloco pra 443 e deixa o 80 só redirecionando.
