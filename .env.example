# Postgres credentials (read by docker-compose via ${...}), and interpolated
# into backend/worker's DATABASE_URL when running the full containerized stack.
# Copy to .env and set the password before the first `npm run dev` / `docker compose up`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=audiomind

# Public backend URL baked into the web build at build time (Next.js
# NEXT_PUBLIC_* vars are inlined during `next build`, not read at runtime).
# Only used by docker-compose (web service build arg); host dev falls back
# to apps/web/.env's default.
NEXT_PUBLIC_API_URL=http://localhost:5000

# HOST ports the containers are published on (localhost only). They are here,
# and not written inside docker-compose.yml, because which ports are free is a
# fact about the MACHINE: with them in the compose file, every server that had
# to move one ended up with a modified docker-compose.yml that conflicts on
# every `git pull`.
#
# ⚠️ BACKEND_PORT and WEB_PORT have to match what the reverse proxy proxies to
# (see deploy/nginx.conf.example). If they drift, Nginx answers 502.
BACKEND_PORT=5001
WEB_PORT=3003
DB_PORT=5433
REDIS_PORT=6380
