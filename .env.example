# Postgres credentials (read by docker-compose via ${...}), and interpolated
# into backend/worker's DATABASE_URL when running the full containerized stack.
# Copy to .env and set the password before the first `npm run dev` / `docker compose up`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=audiomind

# Public backend URL baked into the web build at build time (Next.js
# NEXT_PUBLIC_* vars are inlined during `next build`, not read at runtime).
# Only used by docker-compose (web service build arg); host dev falls back
# to apps/web/.env's default.
NEXT_PUBLIC_API_URL=http://localhost:5000

