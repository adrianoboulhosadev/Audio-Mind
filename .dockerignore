# Secrets never enter an image. A pattern WITHOUT `**/` only matches the ROOT,
# so `.env` alone would still let apps/backend/.env and apps/web/.env in.
.env
**/.env
**/.env.*
!**/.env.example

# Uploaded audio/PDFs are runtime state (a named volume), never image content.
apps/backend/uploads
